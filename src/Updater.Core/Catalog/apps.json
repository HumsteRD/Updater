      "SODA", "SODALanguagePacks", "screen_ai", "WidevineCdm", "MediaFoundationWidevineCdm", "Webstore Downloads",
      "BrowserMetrics", "*.pma", "*.tmp", "**/Service Worker/CacheStorage", "**/Service Worker/ScriptCache",
      "VideoDecodeStats", "hyphen-data", "ZxcvbnData", "Subresource Filter", "MEIPreload", "FileTypePolicies",
      "CertificateRevocation", "Crowd Deny", "TrustTokenKeyCommitments", "OriginTrials", "PKIMetadata",
      "SSLErrorAssistant", "ActorSafetyLists", "AmountExtractionHeuristicRegexes", "CaptchaProviders",
      "AutofillStates", "ClientSidePhishing", "CookieReadinessList", "FirstPartySetsPreloaded",
      "OpenCookieDatabase", "ProbabilisticRevealTokenRegistry", "PrivacySandboxAttestationsPreloaded",
      "RecoveryImproved", "TpcdMetadata", "WasmTtsEngine", "segmentation_platform", "Speech"
    ],
    "brave": [
      // Компоненты Brave (списки блокировки и т. п.) — папки из 32 букв в корне, Brave скачает их сам.
      "/????????????????????????????????"
    ],
    "firefox": [
      "crashes", "minidumps", "Crash Reports", "datareporting", "saved-telemetry-pings", "**/storage/temporary",
      "cache2", "startupCache", "shader-cache", "*.tmp"
    ],
    "telegram": [
      "user_data", "user_data#*", "emoji", "dumps", "temp", "tdummy"
    ]
  },

