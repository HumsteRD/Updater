  // Маска без «/» — имя на любой глубине, «/имя» — только в корне, «**/a/b» — путь.
  "excludeSets": {
    "chromium": [
      "Cache", "Code Cache", "GPUCache", "DawnCache", "DawnGraphiteCache", "DawnWebGPUCache", "GrShaderCache",
      "GraphiteDawnCache", "ShaderCache", "component_crx_cache", "extensions_crx_cache", "Crashpad", "Crash Reports",
