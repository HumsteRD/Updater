{
  // Ручные правила поверх индекса winget: что пропускать, где индекс ошибается,
  // какие программы качать напрямую (их нет в winget).
  "rules": [
    { "match": "^FI$", "name": "FI — Free Internet", "download": "https://github.com/HumsteRD/FreeInternet/releases/latest/download/fi-setup.exe", "note": "Обход блокировок: если без него не открываются YouTube и Discord, поставь его первым" },
    { "match": "^AyuGram", "id": "RadolynLabs.AyuGramDesktop" },
    { "match": "^Microsoft Visual Studio Code", "id": "Microsoft.VisualStudioCode" },
    { "match": "^NVIDIA App", "url": "https://www.nvidia.com/ru-ru/software/nvidia-app/" },
    { "match": "^GitHub Copilot CLI", "id": "GitHub.Copilot" },
    { "match": "^Steam$", "id": "Valve.Steam" },
    { "match": "^Bonjour$", "skip": true },
    { "match": "^Microsoft \\.NET SDK", "skip": true },

    // Популярные программы, которые индекс понимает неточно. Правила проверяются по порядку: частные — выше общих.
    { "match": "^Mozilla Firefox .*\\bru\\)", "id": "Mozilla.Firefox.ru", "name": "Firefox" },
    { "match": "^Mozilla Firefox", "id": "Mozilla.Firefox", "name": "Firefox" },
    { "match": "^Opera GX", "id": "Opera.OperaGX", "name": "Opera GX" },
    { "match": "^Opera Air", "id": "Opera.OperaAir", "name": "Opera Air" },
    { "match": "^Opera Stable", "id": "Opera.Opera", "name": "Opera" },
    { "match": "^Adobe Acrobat", "id": "Adobe.Acrobat.Reader.64-bit", "name": "Adobe Acrobat Reader",
      "note": "Ставится бесплатный Acrobat Reader. Если у тебя платный Acrobat Pro — войди в аккаунт Adobe" },
    { "match": "^(Yandex Music|Яндекс Музыка)", "id": "Yandex.Music", "name": "Яндекс Музыка" },
    { "match": "^Zoom( Workplace)?( \\(64-bit\\))?$", "id": "Zoom.Zoom", "name": "Zoom" },

    // Нет в winget: вместо поиска в Google — официальный сайт.
    { "match": "^Microsoft Office .*(Components|Proofing|Language|Shared|MUI|Click)", "skip": true },
    { "match": "^(Microsoft 365|Microsoft Office)", "name": "Microsoft Office", "url": "https://www.office.com/",
      "note": "Лицензия привязана к аккаунту Microsoft: войди на office.com и установи Office оттуда" },
    { "match": "^(µTorrent|uTorrent)", "url": "https://www.utorrent.com/" },
    { "match": "^Kaspersky", "url": "https://www.kaspersky.ru/downloads" },
    { "match": "^Punto Switcher", "url": "https://yandex.ru/soft/punto/" }
  ],

