<UserControl x:Class="Updater.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource CleanScrollViewer}">
        <Grid Margin="48,36,48,28" MaxWidth="1040">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Переезд на новую Windows" Style="{StaticResource TextTitle}" FontSize="30"/>
                <TextBlock Style="{StaticResource TextBody}" FontSize="14" LineHeight="21" Margin="0,10,0,0" MaxWidth="720" HorizontalAlignment="Left"
                           Text="Соберу со старой системы всё нужное — файлы, список программ, их настройки, сохранения игр и настройки Windows — на флешку или другой диск, вместе с самой программой. На новой винде запустишь её оттуда, и всё встанет на место."/>
            </StackPanel>

            <!-- Найдена сборка: главное действие — распаковать -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,26,0,0" Padding="22,18" BorderBrush="{StaticResource AccentLine}"
                    Background="{StaticResource AccentDim}" Visibility="{Binding HasPackage, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource Accent}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="20" Foreground="{StaticResource AccentText}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PackageTitle}" Style="{StaticResource TextHeading}" FontSize="17"/>
                        <TextBlock Text="{Binding PackageDetail}" Style="{StaticResource TextBody}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding PackagePath}" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource ButtonPrimary}" Command="{Binding Restore}" Padding="22,0" MinHeight="42" FontSize="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Распаковать"/>
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource FontIcons}" FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Два пути -->
            <Grid Grid.Row="2" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="24,22">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,22,0,0" Command="{Binding Collect}" Padding="20,0" MinHeight="40">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPackage}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BgElevated}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Начать сборы"/>
                                <TextBlock Text="&#xE72A;" FontFamily="{StaticResource FontIcons}" FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}" Width="40" Height="40">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="18" Foreground="{StaticResource AccentInk}"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Собрать вещи" Style="{StaticResource TextHeading}" FontSize="18"/>
                                    <TextBlock Text="на старой винде" Style="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextBody}" Margin="0,16,0,0"
                                       Text="Найду твои папки, программы, сохранения игр и настройки, покажу размеры и сложу отмеченное на флешку или другой диск. Займёт от пары минут до часа — зависит от объёма."/>
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource TextMuted}" Text="•  Рабочий стол, документы, видео, папки на диске C:"/>
                                <TextBlock Style="{StaticResource TextMuted}" Text="•  Вход в Telegram, закладки браузеров, сцены OBS, конфиги" Margin="0,4,0,0"/>
                                <TextBlock Style="{StaticResource TextMuted}" Text="•  Сейвы игр, драйверы, Wi-Fi, шрифты, обои и раскладки" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,22">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Browse}" Padding="20,0" MinHeight="40"
                                    Content="Выбрать папку со сборкой" Visibility="{Binding NoPackage, Converter={StaticResource Vis}}"/>
                            <Button Style="{StaticResource ButtonGhost}" Command="{Binding Browse}" MinHeight="40"
                                    Content="Открыть другую сборку" Visibility="{Binding HasPackage, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}" Width="40" Height="40">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="18" Foreground="{StaticResource AccentInk}"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Распаковать" Style="{StaticResource TextHeading}" FontSize="18"/>
                                    <TextBlock Text="на новой винде" Style="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextBody}" Margin="0,16,0,0"
                                       Text="Запусти программу с флешки — она сама найдёт сборку. Поставит драйверы и программы, вернёт файлы и настройки, а Windows настроит так, как было у тебя."/>
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource TextMuted}" Text="•  Программы ставятся сами, без «Далее — Далее»"/>
                                <TextBlock Style="{StaticResource TextMuted}" Text="•  Файлы копируются одновременно с установкой программ" Margin="0,4,0,0"/>
                                <TextBlock Style="{StaticResource TextMuted}" Text="•  Любую настройку Windows можно вернуть, поменять или откатить" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Как это устроено -->
            <Border Grid.Row="3" Margin="0,22,0,0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,18,0,0"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="1" Style="{StaticResource TextMetric}" FontSize="26" Foreground="{StaticResource AccentInk}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource TextBody}" Width="230" VerticalAlignment="Center" Text="Собери вещи на старой винде — на флешку или другой диск"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="2" Style="{StaticResource TextMetric}" FontSize="26" Foreground="{StaticResource AccentInk}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource TextBody}" Width="230" VerticalAlignment="Center" Text="Переустанови Windows, не трогая диск со сборкой"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="3" Style="{StaticResource TextMetric}" FontSize="26" Foreground="{StaticResource AccentInk}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource TextBody}" Width="230" VerticalAlignment="Center" Text="Запусти Updater.exe из сборки и нажми одну кнопку"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="4" Margin="0,26,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource ButtonLink}" Content="Перезапустить с правами администратора"
                        Command="{Binding Elevate}" Visibility="{Binding ShowElevate, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding SystemLine}" Style="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
