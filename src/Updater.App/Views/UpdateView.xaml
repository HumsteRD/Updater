<UserControl x:Class="Updater.App.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="48,36,48,28">
        <Border Style="{StaticResource Card}" Padding="32,28" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource Accent}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="20" Foreground="{StaticResource AccentText}"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Вышла новая версия" Style="{StaticResource TextTitle}" FontSize="22"/>
                        <TextBlock Style="{StaticResource TextBody}" Margin="0,3,0,0">
                            <Run Text="Updater"/>
                            <Run Text="{Binding FromVersion, Mode=OneWay}"/>
                            <Run Text="→"/>
                            <Run Text="{Binding ToVersion, Mode=OneWay}" Foreground="{StaticResource AccentInk}" FontWeight="SemiBold"/>
                            <Run Text="·"/>
                            <Run Text="{Binding SizeText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,20,0,0" Visibility="{Binding HasWhatsNew, Converter={StaticResource Vis}}">
                    <TextBlock Text="Что нового" Style="{StaticResource TextHeading}" FontSize="14"/>
                    <TextBlock Text="{Binding WhatsNew}" Style="{StaticResource TextBody}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,22,0,0" Visibility="{Binding HasError, Converter={StaticResource Vis}, ConverterParameter=!}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DoneText}" Style="{StaticResource TextValue}" FontSize="12" VerticalAlignment="Bottom"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource TextBody}"/>
                    </DockPanel>
                    <ProgressBar Style="{StaticResource Progress}" Value="{Binding Fraction, Mode=OneWay}" Margin="0,10,0,0" Height="8"/>
                </StackPanel>

                <Border Margin="0,22,0,0" Padding="14,10" CornerRadius="8" Background="{StaticResource CriticalDim}"
                        Visibility="{Binding HasError, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Critical}" TextWrapping="Wrap" FontSize="13"/>
                </Border>

                <DockPanel Margin="0,24,0,0">
                    <Button DockPanel.Dock="Left" Style="{StaticResource ButtonLink}" Content="Страница выпуска" Command="{Binding OpenPage}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonSecondary}" Content="{Binding SkipText}" Command="{Binding Skip}" MinHeight="38" Padding="18,0"/>
                        <Button Style="{StaticResource ButtonPrimary}" Content="Ещё раз" Command="{Binding Retry}" Margin="10,0,0,0" MinHeight="38" Padding="18,0"
                                Visibility="{Binding HasError, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock Style="{StaticResource TextMuted}" Margin="0,16,0,0" TextWrapping="Wrap"
                           Text="Меняется только сам Updater.exe — сборки и настройки остаются как есть. Проверяю размер, контрольную сумму и версию файла перед заменой."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
