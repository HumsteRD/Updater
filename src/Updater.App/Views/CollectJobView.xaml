<UserControl x:Class="Updater.App.Views.CollectJobView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,30,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Собираю вещи" Style="{StaticResource TextTitle}"/>
            <TextBlock Style="{StaticResource TextBody}" Margin="0,4,0,0">
                <Run Text="В папку"/>
                <Run Text="{Binding Destination, Mode=OneWay}" Foreground="{StaticResource TextPrimary}"/>
                <Run Text="· компьютер можно не трогать, но лучше не выключать."/>
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24,20" Margin="0,22,0,0">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding DoneText}" Style="{StaticResource TextValue}" FontSize="13" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource TextMuted}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Percent}" Style="{StaticResource TextMetric}" FontSize="44"/>
                </DockPanel>
                <ProgressBar Style="{StaticResource Progress}" Value="{Binding Fraction, Mode=OneWay}" Margin="0,14,0,0" Height="10"/>
                <TextBlock Text="{Binding Current}" Style="{StaticResource TextMuted}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16,12">
                <ScrollViewer Style="{StaticResource CleanScrollViewer}">
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource StatusRow}"/>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,10" Margin="16,0,0,0" Width="420"
                    Visibility="{Binding ShowLog, Converter={StaticResource Vis}}">
                <ScrollViewer Style="{StaticResource CleanScrollViewer}" x:Name="LogScroll">
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource TextValue}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource ButtonGhost}" Content="Журнал" Command="{Binding ToggleLog}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ButtonSecondary}" Content="{Binding PauseText}" Command="{Binding PauseCommand}" Margin="0,0,10,0" MinWidth="120"/>
                <Button Style="{StaticResource ButtonDanger}" Content="Остановить" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
