<UserControl x:Class="Updater.App.Views.RestoreDoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource CleanScrollViewer}">
        <StackPanel Margin="40,30,40,28" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SuccessDim}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource WarningDim}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusGlyph}" FontSize="22">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextBody}" Margin="0,3,0,0" MaxWidth="820" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource StatTile}" Margin="0,24,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Background="{StaticResource AccentDim}" BorderBrush="{StaticResource AccentLine}" Padding="18,14" Margin="0,18,0,0"
                    Visibility="{Binding NeedsReboot, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ButtonPrimary}" Content="Перезагрузить" Command="{Binding Reboot}"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Нужна перезагрузка" Style="{StaticResource TextBase}" FontWeight="SemiBold"/>
                        <TextBlock Text="Часть драйверов, программ и настроек заработает после неё." Style="{StaticResource TextBody}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Visibility="{Binding HasProblems, Converter={StaticResource Vis}}" Margin="0,28,0,0">
                <TextBlock Text="Что не получилось" Style="{StaticResource TextHeading}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource CheckLineRow}"/>
            </StackPanel>

            <TextBlock Text="Осталось сделать руками" Style="{StaticResource TextHeading}" Margin="0,28,0,6"/>
            <ItemsControl ItemsSource="{Binding Todo}" ItemTemplate="{StaticResource CheckLineRow}"/>

            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                <Button Style="{StaticResource ButtonSecondary}" Content="Откатить настройки Windows" Command="{Binding Rollback}" Margin="0,0,10,0"
                        Visibility="{Binding CanRollback, Converter={StaticResource Vis}}"/>
                <Button Style="{StaticResource ButtonGhost}" Content="Журнал" Command="{Binding OpenLog}" Margin="0,0,10,0"/>
                <Button Style="{StaticResource ButtonGhost}" Content="Распаковать ещё раз" Command="{Binding Again}" Margin="0,0,10,0"/>
                <Button Style="{StaticResource ButtonGhost}" Content="Закрыть программу" Command="{Binding Exit}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
