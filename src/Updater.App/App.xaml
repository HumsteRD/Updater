<Application x:Class="Updater.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Updater.App"
             xmlns:views="clr-namespace:Updater.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.xaml"/>
                <ResourceDictionary Source="Theme/Controls.xaml"/>
                <ResourceDictionary Source="Theme/Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Экран по модели: окно показывает текущую страницу, а WPF сам подбирает разметку. -->
            <DataTemplate DataType="{x:Type app:HomeVM}"><views:HomeView/></DataTemplate>
            <DataTemplate DataType="{x:Type app:CollectVM}"><views:CollectView/></DataTemplate>
            <DataTemplate DataType="{x:Type app:CollectJobVM}"><views:CollectJobView/></DataTemplate>
            <DataTemplate DataType="{x:Type app:CollectDoneVM}"><views:CollectDoneView/></DataTemplate>
            <DataTemplate DataType="{x:Type app:RestoreVM}"><views:RestoreView/></DataTemplate>
            <DataTemplate DataType="{x:Type app:RestoreJobVM}"><views:RestoreJobView/></DataTemplate>
            <DataTemplate DataType="{x:Type app:RestoreDoneVM}"><views:RestoreDoneView/></DataTemplate>
            <DataTemplate DataType="{x:Type app:UpdateVM}"><views:UpdateView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
