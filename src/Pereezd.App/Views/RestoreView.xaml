<UserControl x:Class="Pereezd.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Pereezd.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="28,20,28,14">
            <Button DockPanel.Dock="Left" Style="{StaticResource ButtonGhost}" Command="{Binding Back}" Margin="-8,0,10,0" VerticalAlignment="Top" ToolTip="Назад">
                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource FontIcons}" FontSize="14"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ButtonCompact}" Content="Отчёт о сборке" Command="{Binding OpenReport}" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="{Binding Header}" Style="{StaticResource TextTitle}"/>
                <TextBlock Text="{Binding SubHeader}" Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,1,0" Padding="0,10,0,0">
            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Style="{StaticResource NavList}"
                     ItemContainerStyle="{StaticResource NavListItem}" ItemTemplate="{StaticResource SectionNav}"/>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <ScrollViewer Style="{StaticResource CleanScrollViewer}" Padding="20,14,24,20">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedSection.Title}" Style="{StaticResource TextHeading}" FontSize="17"/>
                    <TextBlock Text="{Binding SelectedSection.Hint}" Style="{StaticResource TextMuted}" Margin="0,3,0,10" TextWrapping="Wrap"/>

                    <!-- Обычные разделы: строки с флажками -->
                    <StackPanel Visibility="{Binding SelectedSection.IsItems, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding SelectedSection.Items}" ItemTemplateSelector="{StaticResource ItemSelector}"/>
                        <TextBlock Style="{StaticResource TextMuted}" Margin="12,16,0,0" Text="В сборке этого нет."
                                   Visibility="{Binding SelectedSection.Items.Count, Converter={StaticResource NotEmpty}, ConverterParameter=!}"/>
                    </StackPanel>

                    <!-- Настройки Windows -->
                    <StackPanel Visibility="{Binding SelectedSection.IsSettings, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Style="{StaticResource ButtonCompact}" Content="Всё как было" Command="{Binding AllAsWas}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource ButtonCompact}" Content="Рекомендуемые" Command="{Binding AllRecommended}" Margin="0,0,8,0"
                                    ToolTip="Как было, плюс без рекламы и подсказок, без ускорения мыши, с расширениями файлов и журналом буфера обмена"/>
                            <Button Style="{StaticResource ButtonCompact}" Content="Ничего не менять" Command="{Binding NoneSettings}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SettingGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextLabel}" Margin="2,0,0,4"/>
                                        <Border Style="{StaticResource Card}" Padding="0">
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="16,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="290"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <TextBlock Text="{Binding WasText}" Style="{StaticResource TextMuted}"/>
                                                                        <TextBlock Text="  ·  " Style="{StaticResource TextMuted}" Visibility="{Binding NowText, Converter={StaticResource NotEmpty}}"/>
                                                                        <TextBlock Text="{Binding NowText}" Style="{StaticResource TextMuted}" Visibility="{Binding NowText, Converter={StaticResource NotEmpty}}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource TextMuted}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                               Visibility="{Binding Hint, Converter={StaticResource NotEmpty}}"/>
                                                                    <TextBlock Text="Нужны права администратора" Style="{StaticResource TextMuted}" Foreground="{StaticResource Warning}" Margin="0,3,0,0"
                                                                               Visibility="{Binding NeedsAdmin, Converter={StaticResource Vis}}"/>
                                                                </StackPanel>
                                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" VerticalAlignment="Center"
                                                                          IsEnabled="{Binding NeedsAdmin, Converter={x:Static views:Invert.Instance}}">
                                                                    <ComboBox.Style>
                                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Changes}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ComboBox.Style>
                                                                </ComboBox>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Перед стартом -->
                    <ItemsControl ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource CheckLineRow}"
                                  Visibility="{Binding SelectedSection.IsWarnings, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="28,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ButtonPrimary}" Command="{Binding Start}" MinHeight="42" Padding="22,0" FontSize="14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Начать переезд"/>
                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource FontIcons}" FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource TextBody}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
