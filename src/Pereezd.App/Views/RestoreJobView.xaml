<UserControl x:Class="Pereezd.App.Views.RestoreJobView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,30,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Stage}" Style="{StaticResource TextTitle}"/>
            <TextBlock Text="Программы ставятся из интернета, а файлы в это же время копируются со сборки. Можно отойти — всё идёт само."
                       Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Программы и драйверы -->
            <Border Style="{StaticResource Card}" Padding="20,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AppsText}" Style="{StaticResource TextValue}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentInk}" Margin="0,0,10,0"/>
                                <TextBlock Text="Программы" Style="{StaticResource TextHeading}"/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Progress}" Value="{Binding AppsFraction, Mode=OneWay}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding AppsCurrent}" Style="{StaticResource TextMuted}" Margin="0,8,0,10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ScrollViewer Style="{StaticResource CleanScrollViewer}">
                        <ItemsControl ItemsSource="{Binding Programs}" ItemTemplate="{StaticResource StatusSubRow}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Файлы и настройки -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DataText}" Style="{StaticResource TextValue}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentInk}" Margin="0,0,10,0"/>
                                <TextBlock Text="Файлы, драйверы и настройки" Style="{StaticResource TextHeading}"/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Progress}" Value="{Binding DataFraction, Mode=OneWay}" Margin="0,12,0,0"/>
                        <DockPanel Margin="0,8,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" Style="{StaticResource TextMuted}" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding DataCurrent}" Style="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                    <ScrollViewer Style="{StaticResource CleanScrollViewer}">
                        <ItemsControl ItemsSource="{Binding DataItems}" ItemTemplate="{StaticResource StatusRow}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="14,10" Margin="16,0,0,0" Width="380"
                    Visibility="{Binding ShowLog, Converter={StaticResource Vis}}">
                <ScrollViewer Style="{StaticResource CleanScrollViewer}">
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource TextValue}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource ButtonGhost}" Content="Журнал" Command="{Binding ToggleLog}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ButtonSecondary}" Content="{Binding PauseText}" Command="{Binding PauseCommand}" Margin="0,0,10,0" MinWidth="120"/>
                <Button Style="{StaticResource ButtonDanger}" Content="Остановить" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
