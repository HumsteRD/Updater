<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Тема «Графит» из VELOCITY/FI: нейтральная тёмная основа и один синий акцент.
        Глубина — фоном и волосяной границей, а не тенями. Акцент только там, где действие.
    -->

    <Color x:Key="BgBaseColor">#0E1013</Color>
    <SolidColorBrush x:Key="BgBase" Color="{StaticResource BgBaseColor}"/>
    <SolidColorBrush x:Key="BgInset" Color="#0A0C0E"/>
    <SolidColorBrush x:Key="BgSurface" Color="#15181D"/>
    <SolidColorBrush x:Key="BgElevated" Color="#1B1F25"/>
    <SolidColorBrush x:Key="BgHover" Color="#232830"/>
    <SolidColorBrush x:Key="BgPopup" Color="#1B1F25"/>

    <SolidColorBrush x:Key="BorderSubtle" Color="#232830"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#333A44"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#E9EDF2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A3ACB8"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#6B7480"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#454B54"/>

    <Color x:Key="AccentColor">#3B82F6</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="#5B95F7"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentInk" Color="#8AB4FA"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentDim" Color="#1A2A44"/>
    <SolidColorBrush x:Key="AccentTint" Color="#243B82F6"/>
    <SolidColorBrush x:Key="AccentLine" Color="#733B82F6"/>

    <SolidColorBrush x:Key="NeutralTint" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="SegSelected" Color="#262C35"/>
    <SolidColorBrush x:Key="KnobOff" Color="#A3ACB8"/>

    <SolidColorBrush x:Key="Critical" Color="#F2787C"/>
    <SolidColorBrush x:Key="CriticalDim" Color="#321F24"/>
    <SolidColorBrush x:Key="Warning" Color="#F0BA62"/>
    <SolidColorBrush x:Key="WarningDim" Color="#332C23"/>
    <SolidColorBrush x:Key="Success" Color="#4CC38A"/>
    <SolidColorBrush x:Key="SuccessDim" Color="#1D302C"/>

    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontXs">11</sys:Double>
    <sys:Double x:Key="FontSm">12</sys:Double>
    <sys:Double x:Key="FontMd">13</sys:Double>
    <sys:Double x:Key="FontLg">15</sys:Double>
    <sys:Double x:Key="FontXl">19</sys:Double>

    <CornerRadius x:Key="RadiusSm">5</CornerRadius>
    <CornerRadius x:Key="RadiusMd">7</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>

</ResourceDictionary>
