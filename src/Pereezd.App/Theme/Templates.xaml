<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:Pereezd.Core;assembly=Pereezd.Core"
                    xmlns:app="clr-namespace:Pereezd.App">

    <app:BoolToVisibility x:Key="Vis"/>
    <app:NotEmptyToVisibility x:Key="NotEmpty"/>
    <app:StatusToGlyph x:Key="StatusGlyph"/>
    <app:StatusToBrush x:Key="StatusBrush"/>
    <app:FractionToWidth x:Key="FractionWidth"/>

    <!-- ─────────── Вложенная строка: программа, драйвер, шрифт ─────────── -->

    <DataTemplate x:Key="SubRow" DataType="{x:Type core:SubItem}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected}"
                      Visibility="{Binding Selectable, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource TextMuted}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Detail, Converter={StaticResource NotEmpty}}"/>
                </StackPanel>
            </CheckBox>
            <StackPanel Orientation="Horizontal" Visibility="{Binding Selectable, Converter={StaticResource Vis}, ConverterParameter=!}">
                <Ellipse Width="4" Height="4" Fill="{StaticResource TextTertiary}" Margin="7,0,13,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource TextMuted}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Detail, Converter={StaticResource NotEmpty}}"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="8,0,0,0" Visibility="{Binding Chip, Converter={StaticResource NotEmpty}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ChipIsGood}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SuccessDim}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Chip}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChipIsGood}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource TextValue}" FontSize="11.5" Margin="10,0,0,0"
                       VerticalAlignment="Center" Visibility="{Binding SizeText, Converter={StaticResource NotEmpty}}"/>
            <Button Grid.Column="3" Style="{StaticResource ButtonLink}" Margin="12,0,0,0" VerticalAlignment="Center"
                    Content="{Binding LinkText}" Command="{x:Static app:UiCommands.OpenLink}" CommandParameter="{Binding Link}"
                    Visibility="{Binding Link, Converter={StaticResource NotEmpty}}"/>
        </Grid>
    </DataTemplate>

    <!-- Общая середина строки: иконка, название, путь, пояснение, вложенный список. -->
    <DataTemplate x:Key="ItemBody" DataType="{x:Type core:PlanItem}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto" MinWidth="96"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}" FontSize="13.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Detail, Converter={StaticResource NotEmpty}}" ToolTip="{Binding Detail}"/>
                <TextBlock Text="{Binding Note}" Style="{StaticResource TextBody}" FontSize="12" LineHeight="17" Margin="0,5,0,0"
                           Visibility="{Binding Note, Converter={StaticResource NotEmpty}}"/>
                <StackPanel Visibility="{Binding Children.Count, Converter={StaticResource NotEmpty}}" Margin="0,7,0,0">
                    <ToggleButton x:Name="Expand" Style="{StaticResource Disclosure}">
                        <TextBlock>
                            <Run Text="Список"/>
                            <Run Text="{Binding Children.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </ToggleButton>
                    <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource SubRow}" Margin="0,6,0,2"
                                  Visibility="{Binding IsChecked, ElementName=Expand, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource ChipWarn}" VerticalAlignment="Top" Margin="0,8,0,0"
                    Visibility="{Binding Warning, Converter={StaticResource NotEmpty}}">
                <TextBlock Style="{StaticResource ChipText}" Foreground="{StaticResource Warning}" Text="{Binding Warning}"/>
            </Border>
            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource TextValue}" HorizontalAlignment="Right"
                       VerticalAlignment="Top" Margin="0,9,0,0"/>
        </Grid>
    </DataTemplate>

    <!-- Строка, которую можно отметить: щелчок в любом месте ставит или снимает флажок. -->
    <DataTemplate x:Key="ItemRow" DataType="{x:Type core:PlanItem}">
        <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="0,2">
            <CheckBox Style="{StaticResource RowCheck}" IsChecked="{Binding Selected}">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ItemBody}"/>
            </CheckBox>
        </Border>
    </DataTemplate>

    <!-- Строка-подсказка без флажка (с кнопкой, если есть что сделать). -->
    <DataTemplate x:Key="NoteRow" DataType="{x:Type core:PlanItem}">
        <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="12,12,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ItemBody}"/>
                    <Button Style="{StaticResource ButtonCompact}" Content="Открыть пароли браузера" Margin="46,10,0,0" HorizontalAlignment="Left"
                            Command="{Binding DataContext.OpenPasswords, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding PasswordsUrl, Converter={StaticResource NotEmpty}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <app:ItemTemplateSelector x:Key="ItemSelector" Selectable="{StaticResource ItemRow}" Note="{StaticResource NoteRow}"/>

    <!-- ─────────── Строки прогресса ─────────── -->

    <Style x:Key="StatusIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:ItemStatus.Running}">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Spin">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Spin"/>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="StatusRow" DataType="{x:Type core:PlanItem}">
        <Grid Margin="0,0,0,2" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource StatusIcon}" Text="{Binding Status, Converter={StaticResource StatusGlyph}}"
                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TextBase}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource TextMuted}" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="340" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="StatusSubRow" DataType="{x:Type core:SubItem}">
        <Grid Margin="0,0,0,2" MinHeight="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource StatusIcon}" Text="{Binding Status, Converter={StaticResource StatusGlyph}}"
                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TextBase}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource TextMuted}" VerticalAlignment="Center"
                       Margin="12,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
        </Grid>
    </DataTemplate>

    <!-- ─────────── Чек-лист и цифры итога ─────────── -->

    <DataTemplate x:Key="CheckLineRow" DataType="{x:Type app:CheckLine}">
        <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="4,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontSize="14" VerticalAlignment="Top" Margin="0,1,0,0" HorizontalAlignment="Left">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Warn}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Text}" Style="{StaticResource TextBase}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource TextBody}" FontSize="12" LineHeight="17" Margin="0,3,0,0"
                               Visibility="{Binding Detail, Converter={StaticResource NotEmpty}}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource ButtonCompact}" Content="{Binding ActionText}" Command="{Binding Action}"
                        Margin="16,0,0,0" VerticalAlignment="Top"
                        Visibility="{Binding ActionText, Converter={StaticResource NotEmpty}}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="StatTile" DataType="{x:Type app:Stat}">
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0" MinWidth="150">
            <StackPanel>
                <TextBlock Text="{Binding Value}" Style="{StaticResource TextBase}" FontFamily="{StaticResource FontDisplay}"
                           FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Label}" Style="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ─────────── Пункт меню раздела ─────────── -->

    <DataTemplate x:Key="SectionNav" DataType="{x:Type app:SectionVM}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontFamily="{StaticResource FontMono}" FontSize="11.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Attention}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
